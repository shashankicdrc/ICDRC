{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🟢 API Health at a Glance",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 1000 }
          ]},
          "unit": "ms",
          "decimals": 0,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "text": { "valueSize": 40 }
      },
      "title": "⏱ Avg Response Time",
      "description": "Average time to respond to any API request in the last 5 minutes. Green = fast (<500ms), Red = slow (>1s).",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "1000 * (rate(http_request_duration_seconds_sum{job=\"icdrc-nodejs-backend\"}[5m]) / rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\"}[5m]))",
        "legendFormat": "Response Time"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]},
          "unit": "reqps",
          "decimals": 1,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "text": { "valueSize": 40 }
      },
      "title": "🌐 Requests per Second",
      "description": "How many API requests are being handled right now. Normal traffic is under 50 req/s.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\"}[5m]))",
        "legendFormat": "req/s"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 95 },
            { "color": "green", "value": 99 }
          ]},
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "text": { "valueSize": 40 }
      },
      "title": "✅ API Success Rate",
      "description": "Percentage of requests that completed without a server error (5xx). Should be above 99%.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "100 * (1 - sum(rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\", status_code=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\"}[5m])))",
        "legendFormat": "Success Rate"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
          ]},
          "unit": "reqps",
          "decimals": 2,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "text": { "valueSize": 40 }
      },
      "title": "⚠️ Client Errors (4xx) Rate",
      "description": "Rate of bad request errors — usually caused by invalid input or unauthorized access. A spike here may indicate abuse.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\", status_code=~\"4..\"}[5m]))",
        "legendFormat": "4xx/s"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "🐢 Slowest Routes (P95 Response Time in ms)",
      "description": "95th percentile response time per route. If a route consistently shows >500ms, it needs optimization.",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "1000 * histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"icdrc-nodejs-backend\"}[5m])))",
        "legendFormat": "{{route}}"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "📊 Traffic by Endpoint",
      "description": "Which API endpoints are being called the most. Helps identify popular or overloaded routes.",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum by (method, route) (rate(http_request_duration_seconds_count{job=\"icdrc-nodejs-backend\"}[5m]))",
        "legendFormat": "{{method}} {{route}}"
      }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "💳 Payments & Subscriptions",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short",
          "decimals": 0,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 14 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "💰 Successful Payments (All Time)",
      "description": "Total number of subscription payments that completed successfully since the server started.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(icdrc_subscription_payments_total{status=\"success\"})",
        "legendFormat": "Paid"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]},
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 14 },
      "id": 11,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "❌ Payment Failures (All Time)",
      "description": "Total failed subscription payment attempts. Investigate if this is growing rapidly.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(icdrc_subscription_failures_total)",
        "legendFormat": "Failed"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 80 },
            { "color": "green", "value": 95 }
          ]},
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
      "id": 15,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "valueSize": 40 } },
      "title": "📈 Payment Success Rate",
      "description": "Percentage of subscription payment attempts that succeeded. Should be above 95%.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "100 * sum(icdrc_subscription_payments_total{status=\"success\"}) / (sum(icdrc_subscription_payments_total{status=\"success\"}) + sum(icdrc_subscription_failures_total))",
        "legendFormat": "Success %"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "id": 12,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "🔑 Active Subscriptions (Live)",
      "description": "Number of users with an active subscription right now.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "icdrc_active_subscriptions_gauge",
        "legendFormat": "Active"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 2,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "💳 Payment Outcomes Over Time (by plan)",
      "description": "Shows successful vs failed payments broken down by plan type over time. A growing 'failure' line needs immediate attention.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom_local" },
          "expr": "sum by (status, plan) (rate(icdrc_subscription_payments_total[5m]))",
          "legendFormat": "{{plan}} — {{status}}"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 2,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "🔴 Why Are Payments Failing?",
      "description": "Payment failure reasons over time. Helps identify whether failures are from gateway issues, expired cards, or user cancellations.",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum by (reason) (rate(icdrc_subscription_failures_total[5m]))",
        "legendFormat": "Reason: {{reason}}"
      }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "📧 Email Delivery (BullMQ)",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 27 },
      "id": 20,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "📨 Emails Sent (All Time)",
      "description": "Total emails successfully delivered since server start (confirmations, OTPs, notifications, etc.).",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(icdrc_email_sent_total)",
        "legendFormat": "Sent"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 3 }
          ]},
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 27 },
      "id": 21,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "📛 Email Failures (All Time)",
      "description": "Total emails that failed to deliver. If this is growing, check SMTP credentials and mail server health.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum(icdrc_email_failures_total)",
        "legendFormat": "Failed"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ]},
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 27 },
      "id": 22,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "text": { "valueSize": 40 } },
      "title": "📬 Emails Waiting in Queue",
      "description": "Emails currently sitting in the BullMQ queue waiting to be sent. A large number here means the email worker is falling behind.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "icdrc_bullmq_queue_depth_gauge{queue=\"email-queue\"}",
        "legendFormat": "Queued"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 90 },
            { "color": "green", "value": 99 }
          ]},
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 27 },
      "id": 25,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "text": { "valueSize": 40 } },
      "title": "📮 Email Delivery Rate",
      "description": "Percentage of emails that were successfully delivered. Should be close to 100%.",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "100 * sum(icdrc_email_sent_total) / (sum(icdrc_email_sent_total) + sum(icdrc_email_failures_total))",
        "legendFormat": "Delivery %"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 2,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 23,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "📧 Email Volume by Type Over Time",
      "description": "Breakdown of email types being sent (e.g. verification, payment confirmation, reminders). Useful for understanding communication volume.",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prom_local" },
        "expr": "sum by (type) (rate(icdrc_email_sent_total[5m]))",
        "legendFormat": "{{type}}"
      }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom_local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 2,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 24,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "🔴 Email Failures by Error Code",
      "description": "SMTP error codes causing email failures. Code 550 = mailbox not found, 421 = server unavailable. Contact your mail provider if errors spike.",
